//////////////////////////////////////////////////////
// TAXIS ADMINISTRATOR - ESQUEMA REAL (PostgreSQL)
// Base de datos: taxis_administrator
// Generado desde la BD el 2026-10-16
// NOTA: las ultimas secciones son propuestas: modulo de deudas
// (deuda_movements) y modulo de gastos de vehiculo (vehicle_expenses)
//////////////////////////////////////////////////////

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

Enum drivers_status_enum {
  active
  inactive
  suspended
}

Enum vehicles_vehicle_status_enum {
  active
  inactive
  in_maintenance
  out_of_service
}

Enum tarifas_payment_method_enum {
  cash
  credit_card
  debit_card
  nequi
  daviplata
}

Enum media_tarifas_media_type_enum {
  image
  document
  spreadsheet
  other
}

//////////////////////////////////////////////////////
// TABLE: USERS (usuarios del panel administrativo)
//////////////////////////////////////////////////////

Table users {
  id int [pk, increment]
  name varchar(100) [not null]
  email varchar(100) [not null, unique]
  password varchar(255) [not null] // hash bcrypt, select:false en la entidad
  isActive boolean [not null, default: true]
  lastLogin timestamp [null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// TABLE: ROLES
//////////////////////////////////////////////////////

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique] // USER, ADMIN
  description varchar(255) [null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

//////////////////////////////////////////////////////
// TABLE: PERMISSIONS
//////////////////////////////////////////////////////

Table permissions {
  id int [pk, increment]
  action varchar(100) [not null, unique] // ej: "users.create"

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

//////////////////////////////////////////////////////
// TABLE: USER_ROLES (N a N users <-> roles)
//////////////////////////////////////////////////////

Table user_roles {
  id int [pk, increment]
  user_id int [not null, ref: > users.id] // ON DELETE CASCADE
  role_id int [not null, ref: > roles.id] // ON DELETE CASCADE

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

//////////////////////////////////////////////////////
// TABLE: ROLE_PERMISSIONS (N a N roles <-> permissions)
//////////////////////////////////////////////////////

Table role_permissions {
  id int [pk, increment]
  role_id int [not null, ref: > roles.id]             // ON DELETE CASCADE
  permission_id int [not null, ref: > permissions.id] // ON DELETE CASCADE

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

//////////////////////////////////////////////////////
// TABLE: DRIVERS (conductores)
//////////////////////////////////////////////////////

Table drivers {
  id int [pk, increment]
  name varchar(100) [not null]
  status drivers_status_enum [not null, default: 'active']
  hire_date date [null]
  photo_url text [null]
  phone varchar(50) [null]
  email varchar(100) [null]
  address varchar(255) [null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// TABLE: VEHICLES (vehiculos)
// Relacion 1 a 1 con drivers (driver_id es UNIQUE)
//////////////////////////////////////////////////////

Table vehicles {
  id int [pk, increment]
  plate varchar(20) [not null, unique]
  driver_id int [null, unique, ref: - drivers.id] // ON DELETE SET NULL
  vehicle_status vehicles_vehicle_status_enum [not null, default: 'active']
  driving_restriction_day int [null] // dia de pico y placa (1-7)
  photo_url text [null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// TABLE: VEHICLE_DOCUMENTS (SOAT, tecnomecanica, etc.)
//////////////////////////////////////////////////////

Table vehicle_documents {
  id int [pk, increment]
  vehicle_id int [not null, ref: > vehicles.id] // ON DELETE CASCADE
  document_type_id int [null] // sin FK en BD: no existe tabla document_types
  issue_date date [null]
  expiry_date date [null]
  file_url text [null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// TABLE: TARIFAS (pago/registro diario del conductor)
//////////////////////////////////////////////////////

Table tarifas {
  id int [pk, increment]
  amount decimal(10,2) [not null]
  description text [null]
  payment_method tarifas_payment_method_enum [null]
  tarifa_date date [null]
  driver_id int [null]  // sin FK en BD (ver Ref logicos abajo)
  vehicle_id int [null] // sin FK en BD (ver Ref logicos abajo)

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// TABLE: MEDIA_TARIFAS (comprobantes de la tarifa)
//////////////////////////////////////////////////////

Table media_tarifas {
  id int [pk, increment]
  tarifa_id int [not null, ref: > tarifas.id] // ON DELETE CASCADE
  title varchar(255) [not null]
  description text [null]
  file_url text [not null]
  media_type media_tarifas_media_type_enum [not null, default: 'other']

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// TABLE: VEHICLE_BRANDS
// Existe en la BD pero no tiene entidad TypeORM (tabla huerfana)
//////////////////////////////////////////////////////

Table vehicle_brands {
  id int [pk, increment]
  name varchar(255) [not null, unique]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

//////////////////////////////////////////////////////
// TABLE: VEHICLE_MODELS
// Existe en la BD pero no tiene entidad TypeORM (tabla huerfana)
//////////////////////////////////////////////////////

Table vehicle_models {
  id int [pk, increment]
  name varchar(255) [not null]
  brand_id int [not null, ref: > vehicle_brands.id] // ON DELETE RESTRICT

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
}

//////////////////////////////////////////////////////
// REFS LOGICOS (NO existen como FOREIGN KEY en PostgreSQL)
// La entidad Tarifa guarda driver_id / vehicle_id como int simple.
// Se dibujan aqui para documentar la intencion del modelo.
//////////////////////////////////////////////////////

Ref: tarifas.driver_id > drivers.id
Ref: tarifas.vehicle_id > vehicles.id

//////////////////////////////////////////////////////
//////////////////////////////////////////////////////
//
//  PROPUESTA: MODULO DE DEUDAS (NO IMPLEMENTADO)
//
//  Cuando el conductor no entrega la tarifa queda debiendo. La deuda
//  se acumula de varias tarifas durante semanas y el conductor va
//  abonando de a poco mientras sigue acumulando.
//
//  Por eso NO es "una deuda con abonos" sino una CUENTA CORRIENTE:
//  un libro de movimientos por conductor.
//
//    debt        -> el administrador le carga una deuda  (sube el saldo)
//    payment     -> abono del conductor                  (baja el saldo)
//    forgiveness -> el administrador le perdona           (baja el saldo)
//
//  El saldo NO se guarda en ninguna columna, se calcula:
//    saldo = SUM(debt) - SUM(payment) - SUM(forgiveness)
//
//  REGISTRO MANUAL: el administrador carga las deudas y los abonos a
//  mano. No se infiere la deuda desde las tarifas faltantes, porque
//  la ausencia de tarifa es ambigua (puede ser que no entrego, que no
//  trabajo, pico y placa, carro en taller o festivo). Inferirla
//  exigiria cuota diaria, calendario laboral y proceso de cierre.
//
//  Ventajas de este modelo:
//    - no hay que decidir a cual deuda se le aplica un abono: todo va
//      contra el mismo saldo
//    - una sola tabla, sin datos maestros nuevos
//    - el sistema refleja exactamente como trabaja el administrador hoy
//
//  A cambio: la exactitud del saldo depende de que el administrador
//  registre las deudas. Si olvida una, el saldo queda corto y nada lo
//  detecta. Es el mismo riesgo que tiene hoy en papel.
//
//  EDICION Y BORRADO: se permite editar y eliminar deudas y abonos.
//  Como el saldo se calcula, cualquier cambio se refleja solo en la
//  siguiente consulta, sin nada que sincronizar.
//
//  REGLA EN DRIVERS: drivers usa soft delete, por lo que la FK con
//  ON DELETE RESTRICT nunca se dispara. DriversService debe calcular
//  el saldo antes de softDelete y rechazar si es distinto de 0.
//
//  SALDO NEGATIVO: se permite. Si el conductor abona de mas queda
//  saldo a favor. Evita bloqueos por concurrencia al validar abonos.
//
//////////////////////////////////////////////////////
//////////////////////////////////////////////////////

Enum deuda_movements_type_enum {
  debt        // deuda cargada por el administrador: sube el saldo
  payment     // abono del conductor: baja el saldo
  forgiveness // condonacion del administrador: baja el saldo
}

Enum deuda_movements_payment_method_enum {
  cash
  credit_card
  debit_card
  nequi
  daviplata
}

//////////////////////////////////////////////////////
// TABLE: DEUDA_MOVEMENTS (cuenta corriente del conductor) - PROPUESTA
//
// Una fila por cada movimiento de plata. El amount de cada fila no
// sube ni baja: lo que cambia es el saldo, que es la suma de filas.
//
// Se permite editar y eliminar:
//   - editar: se guarda updatedBy. El monto se puede corregir.
//   - eliminar: SIEMPRE softDelete (deletedAt + deletedBy), nunca
//     DELETE fisico, para conservar el rastro de quien lo borro.
//   - si el type deja de ser 'payment', payment_method pasa a null.
//
// amount SIEMPRE es positivo. El signo lo define `type`.
//
// CHECKS en BD (@Check en la entidad):
//   amount > 0
//   type = 'payment' OR payment_method IS NULL
// No existe tabla de "cuenta" aparte: el saldo es una consulta.
// Guardarlo en columna se desincroniza tarde o temprano.
//
// NO poner indice unico por (driver_id, movement_date): con registro
// manual el administrador puede cargar dos deudas validas el mismo
// dia, y un unico se lo bloquearia.
//////////////////////////////////////////////////////

Table deuda_movements {
  id int [pk, increment]
  driver_id int [not null, ref: > drivers.id] // ON DELETE RESTRICT (la regla real va en DriversService)
  vehicle_id int [null, ref: > vehicles.id]   // ON DELETE SET NULL. Vehiculo con el que se genero

  type deuda_movements_type_enum [not null]
  amount decimal(10,2) [not null] // siempre positivo
  movement_date date [not null]   // fecha real del hecho, no la de captura

  // Solo en type = 'payment'. Reusa el enum TS PaymentMethod pero con
  // tipo propio en Postgres. NO renombrar tarifas_payment_method_enum:
  // con synchronize TypeORM podria recrear tarifas.payment_method y
  // perder los datos.
  payment_method deuda_movements_payment_method_enum [null]

  // Clave con registro manual: es donde el administrador explica el
  // movimiento. "no entrego el 15 y el 17", "abono parcial".
  description text [null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]

  indexes {
    (driver_id, movement_date) // consulta principal: extracto del conductor
  }
}

//////////////////////////////////////////////////////
// TABLE: MEDIA_DEUDA_MOVEMENTS (comprobantes) - PROPUESTA
// Opcional. Mismo patron que media_tarifas.
// Sirve sobre todo para la foto del abono (nequi, transferencia).
//////////////////////////////////////////////////////

Table media_deuda_movements {
  id int [pk, increment]
  movement_id int [not null, ref: > deuda_movements.id] // ON DELETE CASCADE

  title varchar(255) [not null]
  description text [null]
  file_url text [not null]
  media_type media_tarifas_media_type_enum [not null, default: 'other']

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// DONDE SE GUARDA EL ACUMULADO - PROPUESTA
//
// En NINGUNA tabla. El saldo no se guarda, se calcula desde los
// movimientos. Esto es a proposito, no es un olvido del diseño.
//
// POR QUE NO guardarlo en una columna:
//   Si existe drivers.deuda_total y a la vez existen los movimientos,
//   hay DOS verdades. En el momento en que no coincidan (un movimiento
//   anulado, una peticion que falla a mitad, dos abonos simultaneos)
//   nadie sabe cual creer, y cuadrarlo a mano es un infierno.
//   Calculandolo, el historial es la unica verdad posible.
//
// SALDO ACTUAL de un conductor:
//   SELECT COALESCE(SUM(
//            CASE type WHEN 'debt' THEN amount ELSE -amount END
//          ), 0) AS saldo
//   FROM deuda_movements
//   WHERE driver_id = $1 AND "deletedAt" IS NULL;
//
// LISTADO de todos los conductores con su saldo (una sola consulta):
//   SELECT d.id, d.name, COALESCE(SUM(
//            CASE m.type WHEN 'debt' THEN m.amount ELSE -m.amount END
//          ), 0) AS saldo
//   FROM drivers d
//   LEFT JOIN deuda_movements m
//          ON m.driver_id = d.id AND m."deletedAt" IS NULL
//   WHERE d."deletedAt" IS NULL
//   GROUP BY d.id, d.name;
//
// EXTRACTO con saldo corriente (como un estado de cuenta bancario):
//   el acumulado despues de cada movimiento sale con window function,
//   no con una columna:
//   SELECT movement_date, type, amount,
//          SUM(CASE type WHEN 'debt' THEN amount ELSE -amount END)
//            OVER (ORDER BY movement_date, id) AS saldo_corriente
//   FROM deuda_movements
//   WHERE driver_id = $1 AND "deletedAt" IS NULL
//   ORDER BY movement_date, id;
//
// El indice (driver_id, movement_date) ya cubre estas consultas.
//
// SI ALGUN DIA hace falta por rendimiento (miles de movimientos por
// conductor), la forma segura es una columna CACHE en drivers, con la
// regla de que se puede reconstruir desde los movimientos en cualquier
// momento. Cache, no fuente de verdad. Hoy no hace falta.
//////////////////////////////////////////////////////

//////////////////////////////////////////////////////
//////////////////////////////////////////////////////
//
//  PROPUESTA: MODULO DE GASTOS DE VEHICULO (NO IMPLEMENTADO)
//
//  Registra lo que se gasta en cada vehiculo: repuestos, cambios de
//  aceite, mantenimientos, reparaciones, llantas, lavadas, etc.
//
//  Modelo ENCABEZADO + DETALLE, como una factura:
//
//    vehicle_expenses       -> el evento: "cambio de aceite del 15/10
//                              en Lubricentro X, a los 85.300 km"
//    vehicle_expense_items  -> lo que se compro/pago en ese evento:
//                              4 L aceite 20W50, filtro de aceite,
//                              mano de obra
//
//  Por que no una sola tabla con un monto:
//    - un cambio de aceite casi nunca es un solo item (aceite + filtro
//      + mano de obra). Con una sola fila se pierde el detalle de que
//      repuesto se compro y cuanto costo cada uno.
//    - permite reportes por tipo de item (cuanto se gasta en mano de
//      obra vs repuestos) ademas de por categoria de evento.
//
//  EL TOTAL NO SE GUARDA, se calcula (mismo criterio que deudas):
//    total_gasto = SUM(quantity * unit_price) de sus items
//  Si existiera vehicle_expenses.total y a la vez los items, habria
//  dos verdades que tarde o temprano no coinciden.
//
//  KILOMETRAJE: vehicles no tiene columna de km. Se registra el
//  odometro en cada gasto (odometer_km). El km "actual" conocido del
//  vehiculo es el MAX(odometer_km) de sus gastos. Si mas adelante se
//  necesita un km real al dia, va en su propia tabla de lecturas, no
//  aqui.
//
//  PROXIMO SERVICIO: next_service_km / next_service_date permiten
//  alertas tipo "le toca cambio de aceite a los 90.300 km o el
//  15/01". Genericos en el encabezado porque tambien sirven para
//  llantas, frenos, correa de reparticion, etc. La alerta vigente de
//  una categoria es la del gasto MAS RECIENTE de esa categoria: el
//  siguiente cambio de aceite "reemplaza" al anterior sin tener que
//  marcar nada como cumplido.
//
//  SIN CATALOGO DE REPUESTOS por ahora: el item es texto libre
//  (description) + item_type. Un catalogo (tabla supplies) exige
//  mantener datos maestros y hoy no hay inventario ni stock que lo
//  justifique. Si despues se quiere "historial del filtro X" o
//  inventario en bodega, se agrega supply_id null a los items sin
//  romper nada.
//
//  QUIEN PAGA: este modulo registra el gasto del propietario. Si un
//  dano lo debe pagar el conductor, el administrador ademas carga un
//  movimiento 'debt' en deuda_movements. No se enlazan automaticamente
//  para no mezclar los dos libros.
//
//  EDICION Y BORRADO: igual que deudas. Se permite editar; eliminar es
//  SIEMPRE softDelete en el encabezado. Los items se reemplazan
//  completos al editar (borrar e insertar dentro de una transaccion),
//  por eso los items NO tienen soft delete: su rastro es el del
//  encabezado (updatedBy / updatedAt).
//
//  REGLA EN VEHICLES: vehicles usa soft delete, la FK RESTRICT no se
//  dispara. Los gastos se conservan como historial aunque el vehiculo
//  se elimine; no hace falta bloquear el borrado.
//
//////////////////////////////////////////////////////
//////////////////////////////////////////////////////

Enum vehicle_expenses_category_enum {
  oil_change   // cambio de aceite (y filtros asociados)
  maintenance  // mantenimiento preventivo / sincronizacion / revision
  repair       // reparacion correctiva (danos, fallas)
  spare_part   // compra de repuesto suelto sin servicio
  tires        // llantas, alineacion, balanceo
  bodywork     // latoneria y pintura
  wash         // lavada
  other
}

Enum vehicle_expense_items_item_type_enum {
  part   // repuesto: filtro, pastillas, bujias, bateria
  fluid  // aceite, refrigerante, liquido de frenos
  labor  // mano de obra
  other
}

Enum vehicle_expenses_payment_method_enum {
  cash
  credit_card
  debit_card
  nequi
  daviplata
}

//////////////////////////////////////////////////////
// TABLE: VEHICLE_EXPENSES (encabezado del gasto) - PROPUESTA
//
// Un registro por evento de gasto en un vehiculo.
//
// CHECKS en BD (@Check en la entidad):
//   odometer_km IS NULL OR odometer_km >= 0
//   next_service_km IS NULL OR odometer_km IS NULL
//     OR next_service_km > odometer_km
//
// payment_method: tipo propio en Postgres por la misma razon que en
// deuda_movements (no tocar tarifas_payment_method_enum).
//////////////////////////////////////////////////////

Table vehicle_expenses {
  id int [pk, increment]
  vehicle_id int [not null, ref: > vehicles.id] // ON DELETE RESTRICT
  driver_id int [null, ref: > drivers.id]       // ON DELETE SET NULL. Conductor asignado en ese momento

  category vehicle_expenses_category_enum [not null]
  expense_date date [not null] // fecha real del gasto, no la de captura

  odometer_km int [null]       // km del vehiculo al momento del gasto
  next_service_km int [null]   // ej: proximo cambio de aceite a los 90.300 km
  next_service_date date [null]

  supplier varchar(150) [null]      // taller o almacen
  invoice_number varchar(50) [null] // numero de factura del proveedor
  payment_method vehicle_expenses_payment_method_enum [null]
  description text [null]           // notas del administrador

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]

  indexes {
    (vehicle_id, expense_date)           // historial del vehiculo
    (vehicle_id, category, expense_date) // ultimo cambio de aceite / proximo servicio
    expense_date                         // reportes por mes de toda la flota
  }
}

//////////////////////////////////////////////////////
// TABLE: VEHICLE_EXPENSE_ITEMS (detalle del gasto) - PROPUESTA
//
// Cada repuesto, insumo o servicio pagado dentro del gasto.
// Subtotal = quantity * unit_price (no se guarda).
//
// quantity decimal porque el aceite se compra por litros/galones
// (ej: 4.5). unit guarda la unidad para mostrarla ("L", "gal", "und").
//
// CHECKS en BD:
//   quantity > 0
//   unit_price >= 0   // 0 permitido: repuesto en garantia o regalado
//
// Regla en servicio: un gasto debe tener al menos 1 item.
//////////////////////////////////////////////////////

Table vehicle_expense_items {
  id int [pk, increment]
  expense_id int [not null, ref: > vehicle_expenses.id] // ON DELETE CASCADE

  item_type vehicle_expense_items_item_type_enum [not null, default: 'part']
  description varchar(255) [not null] // "Aceite Mobil 20W50", "Filtro de aceite"
  brand varchar(100) [null]
  quantity decimal(10,2) [not null, default: 1]
  unit varchar(20) [null]             // "und", "L", "gal"
  unit_price decimal(10,2) [not null]

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]

  indexes {
    expense_id
  }
}

//////////////////////////////////////////////////////
// TABLE: MEDIA_VEHICLE_EXPENSES (facturas / fotos) - PROPUESTA
// Mismo patron que media_tarifas. Foto de la factura del taller,
// del repuesto cambiado, del odometro.
//////////////////////////////////////////////////////

Table media_vehicle_expenses {
  id int [pk, increment]
  expense_id int [not null, ref: > vehicle_expenses.id] // ON DELETE CASCADE

  title varchar(255) [not null]
  description text [null]
  file_url text [not null]
  media_type media_tarifas_media_type_enum [not null, default: 'other']

  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, default: `now()`]
  deletedAt timestamp [null] // soft delete
  createdBy int [null]
  updatedBy int [null]
  deletedBy int [null]
}

//////////////////////////////////////////////////////
// CONSULTAS PRINCIPALES - PROPUESTA
//
// TOTAL GASTADO por vehiculo (opcionalmente en un rango de fechas):
//   SELECT e.vehicle_id, COALESCE(SUM(i.quantity * i.unit_price), 0) AS total
//   FROM vehicle_expenses e
//   JOIN vehicle_expense_items i ON i.expense_id = e.id
//   WHERE e."deletedAt" IS NULL
//     AND e.expense_date BETWEEN $1 AND $2
//   GROUP BY e.vehicle_id;
//
// GASTO POR CATEGORIA Y MES de un vehiculo:
//   SELECT date_trunc('month', e.expense_date) AS mes, e.category,
//          SUM(i.quantity * i.unit_price) AS total
//   FROM vehicle_expenses e
//   JOIN vehicle_expense_items i ON i.expense_id = e.id
//   WHERE e.vehicle_id = $1 AND e."deletedAt" IS NULL
//   GROUP BY mes, e.category
//   ORDER BY mes;
//
// PROXIMO CAMBIO DE ACEITE de cada vehiculo (el ultimo registrado):
//   SELECT DISTINCT ON (e.vehicle_id)
//          e.vehicle_id, e.expense_date, e.odometer_km,
//          e.next_service_km, e.next_service_date
//   FROM vehicle_expenses e
//   WHERE e.category = 'oil_change' AND e."deletedAt" IS NULL
//   ORDER BY e.vehicle_id, e.expense_date DESC, e.id DESC;
//
// KM CONOCIDO actual del vehiculo:
//   SELECT MAX(odometer_km) FROM vehicle_expenses
//   WHERE vehicle_id = $1 AND "deletedAt" IS NULL;
//
// RENTABILIDAD (cruce con tarifas, para el dashboard):
//   ingresos = SUM(tarifas.amount) del vehiculo en el periodo
